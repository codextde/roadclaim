/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self' https://roadclaim-api.codext.de; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
